# Phoenix OS — copy to .env.local and fill in values

# ── Required (production) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# ── Optional: email (Resend) ───────────────────────────────────────
RESEND_API_KEY=
PHOENIX_OS_SALES_EMAIL=
PHOENIX_OS_NOREPLY_FROM=Phoenix OS <noreply@yourdomain.com>

# ── Optional: AI (inventory OCR, AI assistant, social captions, consult voice) ──
GROQ_API_KEY=
# Optional override (default: whisper-large-v3-turbo)
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Optional: Stripe billing ───────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_GROWTH=

# ── Meta social publishing (Facebook + Instagram OAuth) ────────────
# Create app at https://developers.facebook.com
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/social/meta/callback
META_APP_ID=
META_APP_SECRET=

# ── Camera / integration encryption ───────────────────────────────
# AES-256-GCM key for camera credentials (min 16 chars).
# Falls back to SOCIAL_TOKEN_ENCRYPTION_KEY if unset.
INTEGRATION_ENCRYPTION_KEY=

# ── Camera media gateway (MediaMTX or compatible) ─────────────────
MEDIA_GATEWAY_URL=
MEDIA_GATEWAY_API_URL=
MEDIA_GATEWAY_SECRET=
# ── Phoenix Care mobile (Expo) ─────────────────────────────────────
# Also copy these into mobileappforcustomers/.env
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_APP_URL=http://localhost:3000

